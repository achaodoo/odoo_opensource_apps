<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model='ir.ui.view' id='receipt_register_report_view_form'>
            <field name="name">rec.reg.report.form</field>
            <field name="model">rec.reg.report</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="date_start" required="1"/>
                            <field name="partner_ids" required="0" options="{'no_create':True, 'no_open':True}"
                                   widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="date_end" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_generate_receipt_register_report" string="XLS" type="object"
                                context="{'xls_export':1}" class="oe_highlight"/>
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="receipt_register_report_action" model="ir.actions.act_window">
            <field name="name">Receipt Register Report</field>
            <field name="res_model">rec.reg.report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="receipt_register_report_view_form"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>