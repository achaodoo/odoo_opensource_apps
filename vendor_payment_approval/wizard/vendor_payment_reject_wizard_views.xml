<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vendor_payment_reject_wizard_form" model="ir.ui.view">
        <field name="name">vendor.payment.reject.wizard.form</field>
        <field name="model">vendor.payment.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Vendor Payment">
                <group>
                    <field name="reason"
                           placeholder="Enter the reason for rejecting this payment..."/>
                </group>

                <footer>
                    <button name="action_confirm"
                            string="Reject"
                            type="object"
                            class="btn-danger"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>