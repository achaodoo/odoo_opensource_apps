<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_vendor_payment_approval" model="ir.ui.view">
        <field name="name">view.move.form.inherit.vendor.payment.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='due_date']" position="after">
                <field name="is_register_payment" force_save="1" invisible="1"/>
            </xpath>
            <xpath expr="//header//button[@name='action_register_payment']" position="attributes">
                <attribute name="invisible">
                    is_register_payment or state != 'posted' or payment_state not in ['not_paid', 'partial'] or move_type not in ['in_invoice', 'in_refund']
                </attribute>
            </xpath>
        </field>
    </record>

</odoo>