<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_soa_report" model="report.paperformat">
        <field name="name">SOA Report</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">70</field>
    </record>

    <record id="action_soa_pdf_report" model="ir.actions.report">
        <field name="name">SOA Report</field>
        <field name="model">soa.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">soa_report.soa_pdf_report</field>
        <field name="report_file">soa_report.soa_pdf_report</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="paperformat_id" ref="soa_report.paperformat_soa_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_soa_pdf_report_mail" model="ir.actions.report">
        <field name="name">SOA Report</field>
        <field name="model">soa.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">soa_report.soa_report</field>
        <field name="report_file">soa_report.soa_report</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="paperformat_id" ref="soa_report.paperformat_soa_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_soa_report_xlsx" model="ir.actions.report">
        <field name="name">SOA Report</field>
         <field name="model">soa.report</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">soa_report.soa_report_xlsx</field>
        <field name="report_file">soa_report.soa_report_xlsx</field>
        <field name="binding_type">report</field>
    </record>

</odoo>