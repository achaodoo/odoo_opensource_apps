<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="soa_report_view_form" model="ir.ui.view">
        <field name="name">soa.report.form</field>
        <field name="model">soa.report</field>
        <field name="arch" type="xml">
            <form string="Statement of Account">
                <sheet>
                    <group>
                        <field name="partner_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                               required="1"/>
                        <field name="as_on_date" required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Generate PDF Report" type="object" name="action_generate_pdf" class="btn-primary"/>
                    <button string="Generate Excel Report" type="object" name="action_generate_xlsx_report"
                            class="btn-primary"/>
                    <button string="Send Email" type="object" name="submit_soa_report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_soa_report" model="ir.actions.act_window">
        <field name="name">SOA Report</field>
        <field name="res_model">soa.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="soa_report_view_form"/>
        <field name="target">new</field>
    </record>

</odoo>
