<odoo>
    <record id="view_account_journal_form_inherit_staff_imprest_request" model="ir.ui.view">
        <field name="name">view.account.journal.form.inherit.staff.imprest.request</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_staff_imprest_journal" invisible="type not in ('cash', 'bank')"/>
            </xpath>
        </field>
    </record>
</odoo>