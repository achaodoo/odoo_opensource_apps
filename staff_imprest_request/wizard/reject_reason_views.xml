<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_reject_reason_form_staff_imprest" model="ir.ui.view">
            <field name="name">reject.reason.form.staff.imprest</field>
            <field name="model">staff.imprest.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Imprest Request">
                    <sheet>
                        <group>
                            <field name="reason"
                                   string="Reject Reason"
                                   placeholder="Enter the reason for rejecting this imprest request..."
                                   required="1"/>
                        </group>
                    </sheet>

                    <footer>
                        <button name="action_confirm"
                                string="Reject"
                                type="object"
                                class="btn-primary"/>

                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>