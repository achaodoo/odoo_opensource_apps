<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="1">

        <!-- Employee -->
        <record id="staff_imprest_request_rule_employee" model="ir.rule">
            <field name="name">Staff Imprest Request - Employee</field>
            <field name="model_id" ref="model_staff_imprest_request"/>
            <field name="domain_force">[('employee_id', '=', user.employee_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Administrator -->
        <record id="staff_imprest_request_rule_admin" model="ir.rule">
            <field name="name">Staff Imprest Request - Administrator</field>
            <field name="model_id" ref="model_staff_imprest_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- Finance -->
        <record id="staff_imprest_request_rule_finance" model="ir.rule">
            <field name="name">Staff Imprest Request - Finance</field>
            <field name="model_id" ref="model_staff_imprest_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('staff_imprest_request.group_staff_imprest_finance'))
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Assigned Users -->
        <record id="staff_imprest_request_rule_assigned_user" model="ir.rule">
            <field name="name">Staff Imprest Request - Assigned User</field>
            <field name="model_id" ref="model_staff_imprest_request"/>
            <field name="domain_force">[('assigned_user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Multi Company -->
        <record id="staff_imprest_request_comp_rule" model="ir.rule">
            <field name="name">Staff Imprest Request - Multi Company</field>
            <field name="model_id" ref="model_staff_imprest_request"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>