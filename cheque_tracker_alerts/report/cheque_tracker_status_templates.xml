<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cheque_tracker_status">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <center>
                        <b>
                            <h3>Tracker Status Report</h3>
                        </b>
                    </center>
                    <t t-if="start_date and end_date">
                        <center>
                            <span t-esc="date_start_doc"/>
                            To
                            <span t-esc="date_end_doc"/>
                        </center>
                    </t>
                    <table class="table table-condensed">
                        <tbody>
                            <tr>
                                <th>Sl No.</th>
                                <th>Transaction Ref Number</th>
                                <th>Cheque Date</th>
                                <th>Party Name</th>
                                <th>Cheque Status</th>
                                <th>Cheque Amount</th>
                            </tr>
                            <tr t-foreach="form" t-as="t">
                                <td style="text-align: center;">
                                    <span t-esc="t['sl_no']"/>
                                </td>
                                <td style="text-align: left;">
                                    <span t-esc="t['ref']"/>
                                </td>
                                <td style="text-align: center;">
                                    <span t-esc="t['date']"/>
                                </td>
                                <td style="text-align: left;">
                                    <span t-esc="t['partner_name']"/>
                                </td>
                                <td style="text-align: center;">
                                    <span t-esc="t['cheque_name']"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="'%.2f' % t['cheque_amount']"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
