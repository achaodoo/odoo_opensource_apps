<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_check_tracker_status" model="mail.template">
            <field name="name">Check Tracker Status</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="subject">Tracker Status </field>
            <field name="description">Tracker Status </field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">

                     Hello,
                        <br/>
                        Please check the payment (<span style="font-weight:bold;" t-out="object.name or ''"/>)and take the necessary action.
                        <br/>

                        <br/>
    					Thank you,
                    </p>
                </div>

            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>