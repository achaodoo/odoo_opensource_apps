<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_cheque_tracker_status" model="ir.ui.view">
        <field name="name">account.payment.view.form.inherit.cheque.tracker.status</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <field name="partner_id" position="after">
                <field name="cheque_date" invisible="is_cheque==False"/>
                <field name="cheque_tracker_status_id" invisible="is_cheque==False" options="{'no_create':True, 'no_open':True}" required="1" readonly="1" force_save="1"/>
                <field name="is_cheque" invisible="1"/>
                <field name="alert_required" invisible="1"/>
                <field name="is_mail_sent" invisible="1"/>
                <field name="is_check_tracker" invisible="1"/>
            </field>
        </field>
    </record>


    <record id="view_account_payment_tree_inherit_cheque_tracker_status" model="ir.ui.view">
            <field name="name">account.payment.tree.cheque.tracker.status</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-danger">is_check_tracker == True</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="cheque_tracker_status_id" invisible="is_cheque==False"/>
                <field name="is_check_tracker" invisible="1" optional="hide"/>
                <field name="is_cheque" invisible="1" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>